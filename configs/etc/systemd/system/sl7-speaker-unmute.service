# Sets the rt1320 amp's OT23 L/R output-terminal switches on at boot.
# These default to off even with every other mixer stage on and at full
# volume — without this, speakers are silent with zero errors logged
# anywhere. See scripts and README "Known risk"/speaker section.
#
# Enable with: sudo systemctl enable sl7-speaker-unmute.service

[Unit]
Description=Unmute SL7 rt1320 amp output terminal (OT23 L/R)
After=sound.target alsa-restore.service
Wants=alsa-restore.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sl7-speaker-unmute.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

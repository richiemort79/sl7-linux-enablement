# Re-applies the rt1320 amp OT23 L/R fix AFTER WirePlumber activates the
# sof-soundwire card's ACP profile in the user session. The system-level
# sl7-speaker-unmute.service (etc/systemd/system/) runs earlier at boot,
# before any user logs in — if WirePlumber's own profile activation resets
# amp mixer state as part of opening the device for the first time in a
# session, that would silently undo the early fix. This runs after
# wireplumber.service specifically to catch and re-fix that case.
#
# Enable for all users with: sudo systemctl --global enable sl7-speaker-unmute.service

[Unit]
Description=Unmute SL7 rt1320 amp output terminal (OT23 L/R) after WirePlumber init
After=wireplumber.service pipewire.service
Wants=wireplumber.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sl7-speaker-unmute.sh
RemainAfterExit=yes

[Install]
WantedBy=default.target
